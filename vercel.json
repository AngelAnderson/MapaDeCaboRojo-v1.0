{
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron?job=briefing",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron?job=maintenance",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron?job=alertas",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron?job=hpsa-refresh",
      "schedule": "0 8 1 1,4,7,10 *"
    },
    {
      "path": "/api/cron?job=salud-atencion",
      "schedule": "0 11 * * 1"
    },
    {
      "path": "/api/cron?job=dato",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron?job=registro-qc",
      "schedule": "7 8 1 * *"
    }
  ],
